# ---------- Required ----------

# The address visitors' browsers and WordPress use to reach this hub (DNS A record → this server).
HUB_DOMAIN=chat.presspros.io

# Email for the free Let's Encrypt certificate (expiry notices only).
ACME_EMAIL=you@presspros.io

# From console.anthropic.com → API Keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Only if your API key isn't tied to one workspace (the API will say so in the hub log):
# the workspace ID from console.anthropic.com. Leave empty for workspace keys.
ANTHROPIC_WORKSPACE_ID=

# Generated by scripts/setup-server.sh. Never change HUB_ENCRYPTION_KEY after sites exist:
# it encrypts stored site secrets.
POSTGRES_PASSWORD=
HUB_ENCRYPTION_KEY=
HUB_JWT_SECRET=

# ---------- Optional ----------

# Claude models used for each "Answer quality" level in WordPress.
MODEL_ECONOMY=claude-haiku-4-5-20251001
MODEL_BALANCED=claude-sonnet-5
MODEL_BEST=claude-opus-5-5
AI_MAX_TOKENS=1024

# Cost and abuse limits.
AI_MAX_TURNS_PER_CONVERSATION=40
AI_MAX_TURNS_PER_SITE_DAILY=2000
VISITOR_MESSAGES_PER_MINUTE=12
IDLE_CLOSE_MINUTES=30

# Test mode: canned replies instead of Claude (no API key or credits needed). 1 = on.
AI_MOCK=0

# Push notifications to the LiveAssist app go through Expo's push service and need no setup here.
# Only if you enable "enhanced push security" on expo.dev:
EXPO_ACCESS_TOKEN=
# Only for apps that register raw Firebase tokens (the LiveAssist app doesn't):
FIREBASE_SERVICE_ACCOUNT=

BACKUP_KEEP_DAYS=14
LOG_LEVEL=info
